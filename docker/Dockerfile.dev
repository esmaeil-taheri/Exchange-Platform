FROM python:3.12-slim-bookworm

# uv ships as a static binary; copying it beats installing it from an index.
COPY --from=ghcr.io/astral-sh/uv:0.8.2 /uv /usr/local/bin/uv

# Defaults to the mirror this project builds against; override with
#   --build-arg UV_DEFAULT_INDEX=https://pypi.org/simple
# ARG UV_DEFAULT_INDEX=https://mirror-pypi.runflare.com/simple
ARG UV_DEFAULT_INDEX=https://pypi.org/simple

# UV_PROJECT_ENVIRONMENT — docker-compose.yml bind-mounts the repo over /app,
#   which would shadow a project-local .venv, so the environment lives outside.
# UV_PYTHON_DOWNLOADS — the base image already provides CPython 3.12.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX} \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/opt/venv/bin:$PATH"

RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

WORKDIR /app

RUN mkdir -p /app/users-data && \
    chown -R appuser:appgroup /app

# Only the manifests — so the dependency layer is not invalidated by code edits.
COPY --chown=appuser:appgroup pyproject.toml uv.lock ./

# Includes the dev group (pytest, ruff, flower); the flower service in
# docker-compose.yml runs from this image.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked

COPY --chown=appuser:appgroup . .

RUN chown -R appuser:appgroup /opt/venv

USER appuser

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
