# ─────────────────────────────────────────
# Stage 1: Builder — resolve the environment with uv
# ─────────────────────────────────────────
FROM python:3.12-slim-bookworm AS builder

# uv ships as a static binary; copying it beats installing it from an index.
COPY --from=ghcr.io/astral-sh/uv:0.8.2 /uv /usr/local/bin/uv

# Override when pypi.org is unreachable, e.g.
#   --build-arg UV_DEFAULT_INDEX=https://mirror-pypi.runflare.com/simple
ARG UV_DEFAULT_INDEX=https://pypi.org/simple

# UV_PROJECT_ENVIRONMENT — build outside /app so the runtime copy path is
#   explicit and a bind mount can never shadow the environment.
# UV_PYTHON_DOWNLOADS — the base image already provides CPython 3.12.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX} \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Kept as a safety net: every current dependency resolves to a wheel, but a
# future one shipping only an sdist would need a compiler here.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Only the manifests — so the dependency layer is not invalidated by code edits.
COPY pyproject.toml uv.lock ./

# --locked fails the build if uv.lock is out of date with pyproject.toml, so a
# drifted lock can never reach production silently.
# --no-dev excludes the dev group: no pytest, ruff or flower in the image.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev


# ─────────────────────────────────────────
# Stage 2: Runtime
# ─────────────────────────────────────────
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    DJANGO_SETTINGS_MODULE=config.settings.prod \
    PATH="/opt/venv/bin:$PATH"

# libpq5 for psycopg2, curl for the compose health check and the CD health gate
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN addgroup --system appgroup && \
    adduser --system --ingroup appgroup appuser

WORKDIR /app

# Copy the resolved environment from the builder. Both stages use the identical
# base image, so the interpreter symlinked inside the venv still resolves here.
COPY --from=builder --chown=appuser:appgroup /opt/venv /opt/venv

# Copy app code
COPY --chown=appuser:appgroup . .

# Static root (collectstatic target) and data dir with correct ownership
RUN mkdir -p /app/src/staticfiles /app/users-data && \
    chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

CMD ["gunicorn", "config.wsgi:application", \
     "--chdir", "src", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "4", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
